# Aceminder local settings (this file is ignored by git and never served by the website)
# Paste your Gemini API key after the equals sign, then restart the server.
GEMINI_API_KEY=AQ.Ab8RN6KPXxKFsXJjxOZz7EHCbAPhZac6LhpGUljXbKttIXZdpg

# ---------- Accounts (optional; email sign-up works without any of these) ----------
# Google sign-in: create an OAuth "Web application" client at
# https://console.cloud.google.com/apis/credentials and add http://localhost:8000 and
# http://127.0.0.1:8000 (plus your real domain later) as Authorized JavaScript origins.
# GOOGLE_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com
#
# Apple sign-in: needs an Apple Developer account, a Services ID and an HTTPS domain
# (Apple does not allow localhost). Set the Services ID and the Return URL you registered.
# APPLE_CLIENT_ID=com.yourdomain.aceminder
# APPLE_REDIRECT_URI=https://yourdomain.com/
#
# Password-reset emails (any SMTP provider, e.g. Gmail with an app password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=Aceminder <you@gmail.com>
#
# Your public address once the site is online (used for reset links and secure cookies):
# PUBLIC_URL=https://yourdomain.com
