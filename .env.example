# Copy this file to .env, fill in what you need, then restart the server (python server.py).
# .env is ignored by git and never served by the website.

# ---------- AI questions ----------
GEMINI_API_KEY=

# ---------- Where the site lives ----------
# Your public address once the site is online. Used for Google/Apple return addresses,
# reset links and secure cookies. Leave empty for local testing.
# PUBLIC_URL=https://aceminder.example.com
# 127.0.0.1 keeps the site private to this computer. Use 0.0.0.0 on a server / behind a proxy.
# HOST=0.0.0.0
# PORT=8000

# ---------- Google sign-in ----------
# Google Cloud Console > APIs & Services > Credentials > Create OAuth client ID > Web application.
# Under "Authorized redirect URIs" add (exactly):
#   http://localhost:8000/api/auth/google/callback           (local testing; open the site at localhost)
#   https://YOUR-DOMAIN/api/auth/google/callback               (when online)
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# ---------- Apple sign-in ----------
# Needs a paid Apple Developer account and a public HTTPS address (Apple refuses localhost).
# Identifier = your Services ID. Return URL to register: https://YOUR-DOMAIN/api/auth/apple/callback
# APPLE_CLIENT_ID=com.example.aceminder.web

# ---------- Password-reset emails (any SMTP provider, e.g. Gmail with an app password) ----------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=Aceminder <you@gmail.com>
