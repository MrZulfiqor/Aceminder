# Copy this file to .env, fill in what you need, then restart the server (python server.py).
# .env is ignored by git and never served by the website.

# ---------- AI questions ----------
GEMINI_API_KEY=

# ---------- Where the site lives ----------
# Your public address once the site is online. Used for reset links and secure cookies. Leave empty for local testing.
# PUBLIC_URL=https://aceminder.example.com
# 127.0.0.1 keeps the site private to this computer. Use 0.0.0.0 on a server / behind a proxy.
# HOST=0.0.0.0
# PORT=8000

# ---------- Optional: password-reset emails (any SMTP provider, e.g. Gmail with an app password) ----------
# Forgot-password works without this through recovery codes. With it, players can also get a reset link.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=Aceminder <you@gmail.com>
